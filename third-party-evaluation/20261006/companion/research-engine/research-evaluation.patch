+def _worker(path):
+    stop = threading.Event()
+    signal.signal(signal.SIGTERM, lambda *_: stop.set())
+    try:
+        supervisor.Supervisor(path).supervise(stop, interval_seconds=1)
+    except supervisor.SupervisorError:
+        raise SystemExit(1) from None
