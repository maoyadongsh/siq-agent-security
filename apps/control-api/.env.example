# SIQ Agent Security Control API 配置模板（安全默认值；勿提交真实值）

# 开发模式（1=允许 X-Dev-* 身份头与 SQLite；生产必须为 0 或未设置）
SIQ_AS_DEV=1
SIQ_AS_ALLOW_SQLITE=1
SIQ_AS_DATABASE_URL=sqlite:///./dev.db
# 生产 PostgreSQL 示例：
# SIQ_AS_DATABASE_URL=postgresql+psycopg://siq_as:<secret>@postgres:5432/siq_as

# 生产身份（SIQ_AS_DEV=0 时必配）：
# SIQ_AS_OIDC_JWKS_URL=https://iam.example.com/.well-known/jwks.json
# SIQ_AS_OIDC_ISSUER=https://iam.example.com
# SIQ_AS_JWT_AUDIENCE=siq-agent-security
# SIQ_AS_JWKS_TTL_SECONDS=60
# 生产默认同源；仅在确需跨域时配置 HTTPS 白名单（逗号分隔）：
# SIQ_AS_CORS_ORIGINS=https://security-console.example.com

# 生产任务签名私钥：必须由 Secret Manager 注入 32 字节 base64，禁止写入仓库。
# SIQ_AS_TASK_SIGNING_KEY_SEED=<secret-manager-reference>
# dev 默认保存到 $XDG_STATE_HOME/siq-agent-security/signing-key.seed；可用下列变量覆盖。
# SIQ_AS_SIGNING_KEY_FILE=/absolute/path/outside/repository/signing-key.seed

# 阈值
# Edge 注册码 TTL（秒）：允许 [60, 604800]；启动时越界拒绝。默认 900。
# SIQ_AS_ENROLLMENT_TTL_SECONDS=900
# 注册限速（滑动窗口，键=device_identity / enrollment_code / tenant:env；不按源 IP）：
# SIQ_AS_REGISTER_RATE_LIMIT=30
# SIQ_AS_ENROLLMENT_CREATE_RATE_LIMIT=30
# SIQ_AS_REGISTER_RATE_WINDOW_SECONDS=60
# Outbox worker 领取租约（秒）与最大尝试（DEV12-B；至少一次，非 exactly-once）：
# SIQ_AS_OUTBOX_LEASE_SECONDS=30
# SIQ_AS_OUTBOX_MAX_ATTEMPTS=8
# SIQ_AS_WORKER_ID=worker-a
# SIQ_AS_EDGE_TASK_TTL_SECONDS=3600
# SIQ_AS_HEARTBEAT_STALE_SECONDS=300
# SIQ_AS_SCAN_QUOTA_PER_TENANT=50

# OpenShell 执行后端（非回环网关强制 HTTPS）：
# SIQ_AS_ENFORCEMENT_BACKEND=openshell-cli
# SIQ_AS_OPENSHELL_CLI_BIN=/opt/openshell/bin/openshell
# SIQ_AS_OPENSHELL_GATEWAY_ENDPOINT=https://openshell-gateway.example.com:17671
# 仅本地回环调试可设 SIQ_AS_OPENSHELL_GATEWAY_INSECURE=1。
# 兼容旧式隔离环境时可改为显式绝对路径：
# SIQ_AS_OPENSHELL_ENV_SH=/opt/siq/openshell/env.sh
