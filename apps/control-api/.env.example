# SIQ Agent Security Control API 配置模板（安全默认值；勿提交真实值）

# 开发模式（1=允许 X-Dev-* 身份头与 SQLite；生产必须为 0 或未设置）
SIQ_AS_DEV=1
SIQ_AS_ALLOW_SQLITE=1
SIQ_AS_DATABASE_URL=sqlite:///./dev.db
# 生产 PostgreSQL 示例：
# SIQ_AS_DATABASE_URL=postgresql+psycopg://siq_as:<secret>@postgres:5432/siq_as

# 生产身份（SIQ_AS_DEV=0 时必配）：
# SIQ_AS_OIDC_JWKS_URL=https://iam.example.com/.well-known/jwks.json
# SIQ_AS_OIDC_ISSUER=https://iam.example.com
# SIQ_AS_JWT_AUDIENCE=siq-agent-security

# 阈值
# SIQ_AS_ENROLLMENT_TTL_SECONDS=900
# SIQ_AS_EDGE_TASK_TTL_SECONDS=3600
# SIQ_AS_HEARTBEAT_STALE_SECONDS=300
