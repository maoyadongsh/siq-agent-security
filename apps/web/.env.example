# ---------------------------------------------------------------------------
# SIQ Agent Security Web 控制台 — 环境变量
# 复制为 .env.local 使用；不要提交真实密钥。
#
# 安全不变量：token 不落 localStorage（与 SIQ 平台不变量一致）。
# Bearer token 仅保存在内存（client.setToken），页面刷新即失效；
# 开发/演示环境用 X-Dev-Tenant-Id / X-Dev-User-Id 头注入身份。
# ---------------------------------------------------------------------------

# 控制面 API 基础地址；默认同源 /api/v1，本地 Vite 代理到 127.0.0.1:8600。
VITE_API_BASE=/api/v1

# 开发模式身份注入开关：true 时请求自动携带 X-Dev-Tenant-Id / X-Dev-User-Id / X-Dev-Roles 头。
# 默认为 false；只有本地联调时才显式改为 true。
VITE_DEV_MODE=true
# 仅 VITE_DEV_MODE=true 时生效：
# 注意：dev 模式后端自动种子租户为 "dev-tenant"（apps/control-api/app/main.py），
# 这里应与之一致，否则控制台看不到数据。
VITE_DEV_TENANT_ID=dev-tenant
VITE_DEV_USER_ID=admin@siq.local
# 角色（逗号分隔）。缺省 tenant_admin,security_admin,agent_owner,auditor，
# 覆盖控制台所需权限点（agent:read / finding:manage / env:read / audit:read / agent:confirm）。
VITE_DEV_ROLES=tenant_admin,security_admin,agent_owner,auditor
