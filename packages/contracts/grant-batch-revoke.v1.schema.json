{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq-agent-security.local/contracts/grant-batch-revoke.v1.schema.json",
  "title": "Grant batch revoke v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/apply"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["grant_id", "expected_revision"],
      "properties": {
        "grant_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "integer", "minimum": 0}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "actor_id", "targets"],
      "properties": {
        "schema_version": {"const": "grant-batch-revoke-request/v1"},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "signing_schema", "signature", "batch_id", "actor_id", "action", "expires_at", "items"],
      "properties": {
        "schema_version": {"const": "grant-batch-revoke-plan/v1"},
        "signing_schema": {"const": "local_canonical/v1"},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
        "batch_id": {"type": "string", "pattern": "^gb-[a-f0-9]{64}$"},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "action": {"const": "revoke"},
        "expires_at": {"type": "string", "format": "date-time"},
        "items": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["grant_id", "expected_revision", "subject_id", "platform", "status"],
            "properties": {
              "grant_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "expected_revision": {"type": "integer", "minimum": 0},
              "subject_id": {"type": "string"},
              "platform": {"type": "string"},
              "status": {"enum": ["draft", "pending_approval", "approved", "deployed", "effective"]}
            }
          }
        }
      }
    },
    "apply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "confirmed", "plan"],
      "properties": {
        "schema_version": {"const": "grant-batch-revoke-apply/v1"},
        "confirmed": {"const": true},
        "plan": {"$ref": "#/$defs/plan"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "batch_id", "items"],
      "properties": {
        "schema_version": {"const": "grant-batch-revoke-result/v1"},
        "batch_id": {"type": "string", "pattern": "^gb-[a-f0-9]{64}$"},
        "items": {"type": "array", "minItems": 1, "maxItems": 50, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["grant_id", "status"],
          "allOf": [{"if": {"properties": {"status": {"enum": ["revoked", "already_revoked"]}}}, "then": {"required": ["state_revision"]}}],
          "properties": {
            "grant_id": {"type": "string"},
            "status": {"enum": ["revoked", "already_revoked", "conflict", "unavailable"]},
            "state_revision": {"type": "integer", "minimum": 0}
          }
        }}
      }
    }
  }
}
