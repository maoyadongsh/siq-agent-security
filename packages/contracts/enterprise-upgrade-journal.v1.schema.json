{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq-agent-security.local/contracts/enterprise-upgrade-journal.v1.schema.json",
  "title": "Private pending enterprise upgrade; neither permission nor completed installation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "confirmation_sha256",
    "state_baseline_sha256",
    "original_plan_bytes",
    "restored_state_sha256",
    "target_state_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "enterprise-upgrade-pending/v1"
    },
    "intent": {
      "$ref": "https://siq-agent-security.local/contracts/enterprise-upgrade-review.v1.schema.json#/properties/intent"
    },
    "confirmation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_plan_bytes": {
      "type": "string",
      "minLength": 4,
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "restored_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
