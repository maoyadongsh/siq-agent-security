{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq.dev/contracts/openshell-behavior-agent.v2.schema.json",
  "title": "Bounded ELF behavior probe observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id",
    "nonce",
    "endpoint",
    "program_path",
    "program_sha256",
    "uid",
    "outcome",
    "elapsed_ms",
    "transport",
    "proxy_endpoint",
    "proxy_status",
    "proxy_error"
  ],
  "properties": {
    "schema_version": {
      "const": "openshell-behavior-agent/v2"
    },
    "verification_id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^opv-[a-f0-9]{32}$"
    },
    "nonce": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "endpoint": {
      "type": "string",
      "maxLength": 21,
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]{1,5}$"
    },
    "program_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^/[A-Za-z0-9_./-]+$"
    },
    "program_sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967294
    },
    "outcome": {
      "enum": [
        "connected",
        "timeout",
        "connection_refused",
        "connection_reset",
        "probe_error",
        "proxy_denied"
      ]
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11000
    },
    "transport": {
      "const": "http_connect"
    },
    "proxy_endpoint": {
      "type": "string",
      "maxLength": 21
    },
    "proxy_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599
    },
    "proxy_error": {
      "enum": [
        "",
        "policy_denied",
        "other"
      ]
    }
  }
}
