{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq.dev/contracts/deployment-preview-submit.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_request_id",
    "environment_id",
    "binding_id",
    "preview_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "deployment-preview-submit/v1"
    },
    "change_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "preview_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
