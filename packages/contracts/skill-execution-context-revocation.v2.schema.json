{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq-agent-security/contracts/skill-execution-context-revocation.v2.schema.json",
  "title": "Signed native skill execution context revocation V2",
  "description": "Immutable tombstone bound to the exact v2 context signature; not accepted by the v1 reader.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "skill-execution-context-revocation/v2"
    },
    "context_id": {
      "type": "string",
      "pattern": "^sec-[0-9a-f]{32}$"
    },
    "issuer_id": {
      "const": "local-admin"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "signing_schema": {
      "const": "local_canonical/v1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "context_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "schema_version",
    "context_id",
    "issuer_id",
    "revoked_at",
    "signing_schema",
    "signature",
    "context_signature"
  ]
}
