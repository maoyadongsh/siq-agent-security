{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fingerprint",
    "status",
    "observed_at",
    "expires_at",
    "inference_verified"
  ],
  "properties": {
    "schema_version": {
      "const": "local-model-connection-result/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^mc-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "listed",
        "not_listed",
        "auth_failed",
        "rate_limited",
        "unreachable",
        "unsupported_response",
        "service_error"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "inference_verified": {
      "const": false
    }
  }
}
