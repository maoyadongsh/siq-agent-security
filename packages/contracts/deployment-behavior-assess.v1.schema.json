{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq.dev/contracts/deployment-behavior-assess.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_id"
  ],
  "properties": {
    "schema_version": {
      "const": "deployment-behavior-assess/v1"
    },
    "verification_id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^opv-[a-f0-9]{32}$"
    }
  }
}
