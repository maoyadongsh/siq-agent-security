{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enterprise-install-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_arch", "service_mode", "connectors"],
  "properties": {
    "schema_version": {"const": "enterprise-install-request/v1"},
    "target_arch": {"enum": ["arm64", "amd64"]},
    "service_mode": {"enum": ["user", "system"]},
    "connectors": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": {"enum": ["hermes", "openclaw", "directory", "docker", "process", "systemd", "kubernetes", "mcp", "piagent", "workbuddy", "dify", "siq"]}
    }
  }
}
