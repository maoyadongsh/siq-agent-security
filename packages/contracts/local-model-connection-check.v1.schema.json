{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "local-model-connection-check/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^mc-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
