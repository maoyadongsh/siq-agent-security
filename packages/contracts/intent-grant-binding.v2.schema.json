{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/intent-grant-binding.v2.schema.json",
  "title": "Signed managed session binding with versioned Grant interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "platform",
    "session_id",
    "agent_id",
    "task_id",
    "intent_id",
    "intent_digest",
    "bound_at",
    "expires_at",
    "authority_revision",
    "signature",
    "grant_ref",
    "schema_version"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "authority_revision": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "grant_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "admission_id",
        "permission_digest",
        "permission_digest_schema"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "admission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "permission_digest_schema": {
          "const": "grant-permissions/v2"
        }
      }
    },
    "schema_version": {
      "const": "intent-grant-binding/v2"
    }
  }
}
