{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://siq-agent-security.local/schemas/grant-tool-approval.v1.json",
  "title": "GrantToolApprovalRequestV1",
  "description": "Admin-only POST /v1/grants/{id}/require-approval, pending grants only. Adds per-use approval conditions to existing allowed tool facts; cannot grant a new tool or remove an approval condition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_revision", "actor_id", "tools"],
  "properties": {
    "schema_version": {"const": "grant-tool-approval/v1"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "actor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "tools": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
