{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Completed Windows resource state compatibility transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_sha256",
    "marker_sha256"
  ],
  "properties": {
    "schema": {
      "const": "state-windows-profile-done/v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "marker_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
