{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parameter_path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?:/(?:[^~]|~[01])*)+$"
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    }
  },
  "required": [
    "parameter_path",
    "provenance_refs"
  ]
}
