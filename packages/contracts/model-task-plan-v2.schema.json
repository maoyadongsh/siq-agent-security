{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-task-plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "skills"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "input"
          ],
          "properties": {
            "name": {
              "const": "secure-research"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "question",
                "scope"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "question": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "scope": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "input"
          ],
          "properties": {
            "name": {
              "const": "secure-report"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "input"
          ],
          "properties": {
            "name": {
              "const": "secure-delivery"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contact"
              ],
              "properties": {
                "contact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      ],
      "items": false
    }
  }
}
