{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-submission.v1.schema.json",
  "title": "deployment-submission/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "change_id",
    "deployment_id",
    "state",
    "deployment_status",
    "preview_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "deployment-submission/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "state": {
      "enum": [
        "unconfirmed",
        "recorded",
        "needs_attention"
      ]
    },
    "deployment_status": {
      "enum": [
        "pending",
        "sent",
        "effective",
        "failed",
        "rolled_back"
      ]
    },
    "preview_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
