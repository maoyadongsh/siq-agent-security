{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://siq-agent-security.local/schemas/evidence.v1.json",
  "title": "Evidence",
  "description": "支持资产、权限或风险判断的可验证证据。字段对齐设计文档 §10.5；原始配置不默认上传，payload_ref 仅在管理员批准且满足驻留策略时存在。",
  "type": "object",
  "required": [
    "evidence_id",
    "source_type",
    "source_locator",
    "observed_at",
    "collected_at",
    "collector_id",
    "connector_version",
    "content_hash",
    "redaction_profile",
    "classification",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence_id": { "type": "string", "description": "租户内唯一（tenant_id + evidence_id 复合唯一）" },
    "tenant_id": { "type": "string" },
    "environment_id": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["registry", "manifest", "process", "container", "k8s", "iam", "gateway", "openshell", "human", "deny_log"]
    },
    "source_locator": { "type": "string", "description": "脱敏后的稳定来源定位，不含凭据" },
    "subject_ref": { "type": ["string", "null"], "description": "Candidate / Asset / Instance 引用" },
    "observed_at": { "type": "string", "format": "date-time", "description": "来源事实的观察时间" },
    "collected_at": { "type": "string", "format": "date-time", "description": "Collector 采集时间" },
    "collector_id": { "type": "string", "description": "采集主体（Edge Agent 设备身份）" },
    "connector_version": { "type": "string" },
    "content_hash": { "type": "string", "description": "原始证据规范化后的 sha256" },
    "redaction_profile": { "type": "string", "description": "使用的脱敏规则版本，如 siq.redaction.v1" },
    "classification": { "type": "string", "enum": ["public", "internal", "confidential", "secret_ref"] },
    "payload_ref": { "type": ["string", "null"], "description": "加密对象引用；默认 null（仅结构化摘要）" },
    "signature": { "type": "string", "description": "Edge 对证据包的签名或证明（Ed25519，hex）" },
    "expires_at": { "type": ["string", "null"], "format": "date-time", "description": "证据新鲜度或例外失效时间" }
  }
}
