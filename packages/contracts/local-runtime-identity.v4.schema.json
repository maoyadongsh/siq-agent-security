{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native Skill required runtime identity signed private record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_id",
    "instance_id",
    "agent_id",
    "platform",
    "grant_ref",
    "actor_id",
    "created_at",
    "session_ttl_seconds",
    "credential_hash",
    "signature",
    "native_skill_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-identity/v4"
    },
    "identity_id": {
      "type": "string",
      "pattern": "^ri-[a-f0-9]{32}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^hi-[a-f0-9]{32}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^hri-[a-f0-9]{32}$"
    },
    "platform": {
      "const": "hermes"
    },
    "grant_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "admission_id",
        "permission_digest"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "admission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "credential_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "native_skill_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime_artifact_sha256"
      ],
      "properties": {
        "mode": {
          "const": "required"
        },
        "runtime_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
