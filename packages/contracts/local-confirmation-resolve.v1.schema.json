{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-confirmation-resolve.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_receipt_id",
    "decision_hash",
    "params_digest",
    "approve",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "local-confirmation-resolve/v1"
    },
    "decision_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "params_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approve": {
      "type": "boolean"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
