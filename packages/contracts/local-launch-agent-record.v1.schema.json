{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-launch-agent-record.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "state_directory_id",
    "plist_sha256",
    "schema_version",
    "label",
    "signature"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_directory_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plist_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "local-launch-agent-record/v1"
    },
    "label": {
      "type": "string",
      "pattern": "^dev\\.siq\\.agent-security\\.[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
