{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "completion-status/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "verified",
        "incomplete",
        "conflicting",
        "unknown"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requirements": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "verified",
              "incomplete",
              "conflicting",
              "unknown"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 8192,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "requirement_id",
          "status",
          "reason_code",
          "evidence_ids"
        ]
      }
    },
    "incident_ids": {
      "type": "array",
      "maxItems": 8192,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "status",
    "reason_code",
    "requirements",
    "incident_ids"
  ]
}
