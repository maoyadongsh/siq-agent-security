{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-update-recover.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "local-skill-update-recover/v1"
    },
    "update_id": {
      "type": "string",
      "pattern": "^sup-[a-f0-9]{64}$"
    },
    "claim_signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "confirm_recovery": {
      "const": true
    }
  },
  "required": [
    "schema_version",
    "update_id",
    "claim_signature",
    "actor_id",
    "confirm_recovery"
  ]
}
