{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq-agent-security/contracts/context-assertion.v1.schema.json",
  "title": "Signed context assertion V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "context-assertion/v1"
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "issuer_id": {
      "const": "local-admin"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "session_id",
        "agent_id"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_root"
      ],
      "properties": {
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signing_schema": {
      "const": "local_canonical/v1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "schema_version",
    "assertion_id",
    "issuer_id",
    "subject",
    "task_id",
    "claims",
    "issued_at",
    "expires_at",
    "request_binding",
    "signing_schema",
    "signature"
  ]
}
