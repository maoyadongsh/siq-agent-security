{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-import-create.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "source_kind",
    "path",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "local-skill-import-create/v1"
    },
    "import_id": {
      "type": "string",
      "pattern": "^si-[0-9a-f]{32}$"
    },
    "source_kind": {
      "enum": [
        "local_dir",
        "local_zip"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
