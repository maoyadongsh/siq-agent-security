{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "configuration_fingerprint",
    "sandbox_id",
    "name",
    "endpoint_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "local-openshell-gateway-inspect/v1"
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^og-[0-9a-f]{32}$"
    },
    "configuration_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sandbox_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}$"
    },
    "endpoint_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
