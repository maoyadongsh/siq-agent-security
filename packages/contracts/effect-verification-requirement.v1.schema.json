{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "effect_type": {
      "const": "file.write"
    },
    "resource_ref": {
      "type": "string",
      "pattern": "^filesystem:sha256:[0-9a-f]{64}$"
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_independence": {
      "enum": [
        "host_independent",
        "external_independent"
      ]
    },
    "minimum_coverage": {
      "enum": [
        "partial",
        "full"
      ]
    }
  },
  "required": [
    "requirement_id",
    "effect_type",
    "resource_ref",
    "expected_digest",
    "minimum_independence",
    "minimum_coverage"
  ]
}
