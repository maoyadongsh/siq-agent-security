{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "file-observation-pending/v2"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "platform",
        "session_id",
        "agent_id",
        "task_id"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "host_observer"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "independence": {
          "const": "host_independent"
        }
      },
      "required": [
        "type",
        "source_id",
        "independence"
      ]
    },
    "before": {
      "$ref": "file-snapshot.v2.schema.json"
    },
    "owner_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "signing_schema": {
      "const": "local_canonical/v1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "action_id",
    "decision_receipt_id",
    "scope",
    "source",
    "before",
    "owner_digest",
    "expected_digest",
    "max_bytes",
    "expires_at",
    "signing_schema",
    "signature",
    "intent_id",
    "intent_digest"
  ]
}
