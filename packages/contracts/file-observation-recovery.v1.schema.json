{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "file-observation-recovery/v1"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "pending_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recovered_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "signing_schema": {
      "const": "local_canonical/v1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "sequence",
    "pending_digest",
    "previous_hash",
    "owner_digest",
    "recovered_at",
    "signing_schema",
    "signature"
  ]
}
