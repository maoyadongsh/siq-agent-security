{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://siq-agent-security.local/schemas/runtime-action-envelope.v1.json",
  "title": "RuntimeActionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "platform",
    "session_id",
    "agent_id",
    "task_id",
    "intent_id",
    "tool",
    "operation",
    "effects",
    "params_digest",
    "occurred_at"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "params_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
