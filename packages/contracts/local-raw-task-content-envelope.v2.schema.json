{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "local-raw-task-content-envelope.v2.schema.json",
  "title": "Encrypted task content with authenticated runtime provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "task_ref",
    "kind",
    "created_at",
    "expires_at",
    "plaintext_sha256",
    "plaintext_bytes",
    "omitted_secret_count",
    "algorithm",
    "nonce_base64",
    "ciphertext_base64",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "local-raw-task-content-envelope/v2"
    },
    "record_id": {
      "type": "string",
      "pattern": "^raw-[a-f0-9]{32}$"
    },
    "task_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "input",
        "parameters",
        "output",
        "note"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "plaintext_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plaintext_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "omitted_secret_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "algorithm": {
      "const": "aes-256-gcm/v1"
    },
    "nonce_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{16}$"
    },
    "ciphertext_base64": {
      "type": "string",
      "minLength": 24,
      "maxLength": 1398120,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_identity_ref",
        "session_ref",
        "binding_ref"
      ],
      "properties": {
        "runtime_identity_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "session_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "binding_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
