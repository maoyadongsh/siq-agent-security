{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-install-parent-fact.v1.schema.json",
  "description": "Signed identity checkpoint for an intermediate parent created by this V2 install transaction. At most two facts are permitted per install; a fact supplements and never replaces the signed preview anchor. Existing or unowned parents cannot acquire an ownership fact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "install_id", "claim_signature", "relative_parent", "identity_digest", "recorded_at", "signature"],
  "properties": {
    "schema_version": {"const": "local-skill-install-parent-fact/v1"},
    "install_id": {"type": "string", "pattern": "^sin-[a-f0-9]{64}$"},
    "claim_signature": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
    "relative_parent": {"enum": ["skills", ".codebuddy", ".codebuddy/skills"]},
    "identity_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{128}$"}
  }
}
