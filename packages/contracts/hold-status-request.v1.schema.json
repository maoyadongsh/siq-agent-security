{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Read-only local hold status request",
  "type": "object",
  "additionalProperties": false,
  "required": ["platform", "session_id", "agent_id", "tool", "tool_call_id", "action_id", "decision_receipt_id", "params"],
  "properties": {
    "platform": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "tool_call_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "decision_receipt_id": {"type": "string", "minLength": 1},
    "params": {"type": "object"},
    "task_id": {"type": "string", "maxLength": 256, "description": "决策回执中的可信 Intent 任务标识。"},
    "runtime_task_id": {"type": "string", "maxLength": 256, "description": "决策回执中的宿主任务标识；task 级 SEC 在 hold 复查时重绑同一宿主任务。"}
  }
}
