{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siq.local/siq/events/event-envelope-core.v1.schema.json",
  "title": "SIQ Event Envelope Core v1",
  "description": "Shared identity fields for domain event envelopes. Domain schemas add extras (schema_version type, event_type enum, aggregate). Do not copy a domain envelope over another domain.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object"
    }
  }
}
