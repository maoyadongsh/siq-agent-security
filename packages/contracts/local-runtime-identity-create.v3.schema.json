{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "title": "Management enrollment with mandatory native Skill call policy",
  "required": [
    "schema_version",
    "instance_id",
    "grant_id",
    "expected_grant_revision",
    "actor_id",
    "session_ttl_seconds",
    "native_skill_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-identity-create/v3"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^hi-[a-f0-9]{32}$"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_grant_revision": {
      "type": "integer",
      "minimum": 0
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_ttl_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "native_skill_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "runtime_artifact_sha256"
      ],
      "properties": {
        "mode": {
          "const": "required"
        },
        "runtime_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
