{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision_receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observation": {
      "$ref": "network-observation.v1.schema.json"
    }
  },
  "required": [
    "observation_id",
    "action_id",
    "decision_receipt_id",
    "observation"
  ]
}
