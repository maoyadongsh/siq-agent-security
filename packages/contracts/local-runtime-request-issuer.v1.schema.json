{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_identity_id",
    "scope_id",
    "max_identity_seconds",
    "expires_at",
    "actor_id",
    "parent_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-request-issuer/v1"
    },
    "parent_identity_id": {
      "type": "string",
      "pattern": "^ri-[a-f0-9]{32}$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "max_identity_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
