{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "model_id",
    "fingerprint",
    "confirm_test"
  ],
  "properties": {
    "schema_version": {
      "const": "local-model-inference-create/v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^mt-[0-9a-f]{32}$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^mc-[0-9a-f]{32}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirm_test": {
      "const": true
    }
  }
}
