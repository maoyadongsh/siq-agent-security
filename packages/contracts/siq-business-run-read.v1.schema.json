{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq.dev/contracts/siq-business-run-read.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "run_id",
    "expected_snapshot",
    "confirm_display"
  ],
  "properties": {
    "schema_version": {
      "const": "siq.business-run-read/v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expected_snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirm_display": {
      "const": true
    }
  }
}
