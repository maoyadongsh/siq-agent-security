{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-user-service-record.v1.schema.json",
  "title": "Local user service ownership intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instance_id",
    "state_directory_id",
    "unit_name",
    "unit_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "local-user-service-record/v1"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_directory_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unit_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unit_name": {
      "type": "string",
      "pattern": "^siq-agent-security-[a-f0-9]{32}\\.service$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
