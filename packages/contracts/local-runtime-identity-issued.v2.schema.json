{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "credential_path"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-identity-issued/v2"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "instance_id",
        "agent_id",
        "platform",
        "grant_ref",
        "actor_id",
        "created_at",
        "session_ttl_seconds",
        "status",
        "runtime_state",
        "filesystem_profile"
      ],
      "properties": {
        "identity_id": {
          "type": "string",
          "pattern": "^ri-[a-f0-9]{32}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^hi-[a-f0-9]{32}$"
        },
        "agent_id": {
          "type": "string",
          "pattern": "^hri-[a-f0-9]{32}$"
        },
        "platform": {
          "enum": [
            "hermes",
            "openclaw",
            "workbuddy"
          ]
        },
        "grant_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grant_id",
            "admission_id",
            "permission_digest",
            "permission_digest_schema"
          ],
          "properties": {
            "grant_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "admission_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "permission_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "permission_digest_schema": {
              "const": "grant-permissions/v2"
            }
          }
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "session_ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "status": {
          "enum": [
            "issued",
            "revoked",
            "grant_unavailable"
          ]
        },
        "runtime_state": {
          "const": "unverified"
        },
        "filesystem_profile": {
          "const": "windows-local-drive/v1"
        }
      }
    },
    "credential_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
