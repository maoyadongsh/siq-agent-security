{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siq.dev/contracts/change-review-decision.v1.schema.json",
  "title": "change-review-decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "review_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "change-review-decision/v1"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "review_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
