{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siq.dev/contracts/local-skill-install-operation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "install_id",
    "plan_id",
    "claim_signature",
    "status",
    "actor_id",
    "recorded_at",
    "runtime_verified",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "local-skill-install-operation/v1"
    },
    "install_id": {
      "type": "string",
      "pattern": "^sin-[a-f0-9]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sip-[a-f0-9]{64}$"
    },
    "claim_signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "status": {
      "enum": [
        "installed_unverified",
        "rolled_back",
        "recovery_required"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_verified": {
      "const": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
