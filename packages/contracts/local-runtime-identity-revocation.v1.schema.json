{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "local-runtime-identity-revocation signed local record (not HTTP response)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_id",
    "identity_digest",
    "actor_id",
    "revoked_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-identity-revocation/v1"
    },
    "identity_id": {
      "type": "string",
      "pattern": "^ri-[a-f0-9]{32}$"
    },
    "identity_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    }
  }
}
