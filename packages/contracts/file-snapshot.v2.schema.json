{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resource_ref": {
      "type": "string",
      "pattern": "^filesystem:sha256:[0-9a-f]{64}$"
    },
    "exists": {
      "type": "boolean"
    },
    "digest": {
      "type": "string",
      "pattern": "^([0-9a-f]{64})?$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "mtime": {
      "type": "string",
      "maxLength": 64
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "schema_version": {
      "const": "file-snapshot/v2"
    },
    "filesystem_profile": {
      "const": "windows-local-drive/v1"
    },
    "identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parent_identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "resource_ref",
    "exists",
    "digest",
    "size",
    "mtime",
    "captured_at",
    "schema_version",
    "filesystem_profile",
    "identity_digest",
    "parent_identity_digest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "exists": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "digest": {
            "const": ""
          },
          "size": {
            "const": 0
          },
          "mtime": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mtime": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Windows file snapshot V2"
}
