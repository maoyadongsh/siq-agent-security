{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_id",
    "cancelled",
    "issued"
  ],
  "properties": {
    "schema_version": {
      "const": "local-runtime-request-identity-cancelled/v1"
    },
    "identity_id": {
      "type": "string",
      "pattern": "^ri-[a-f0-9]{32}$"
    },
    "cancelled": {
      "const": true
    },
    "issued": {
      "type": "boolean"
    }
  }
}
