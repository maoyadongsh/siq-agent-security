SIQ_PROFILE=hackathon
SIQ_MODEL_PROVIDER=stepfun
SIQ_STEPFUN_ENDPOINT=https://api.stepfun.com/step_plan/v1
SIQ_STEPFUN_MODEL=step-3.7-flash
SIQ_STEPFUN_API_KEY=
# Service endpoint variables are explicit; do not probe a personal SIQ profile.
SIQ_HACKATHON_SIQ_ENDPOINT=
SIQ_HACKATHON_AGENT_ENDPOINT=
SIQ_HACKATHON_WEB_ENDPOINT=
SIQ_HACKATHON_FIXTURE_ENDPOINT=

# Trusted V4 policy; never derived from user/model/source text.
SIQ_SOURCE_SENSITIVITY=PUBLIC
SIQ_PUBLIC_RESEARCH_LOCAL=true
SIQ_INTERNAL_REMOTE=false
SIQ_SECRET_LOCAL=false
SIQ_ORNITH_ENDPOINT=http://127.0.0.1:8006/v1
SIQ_ORNITH_MODEL=Ornith-1.5-35B-A3B-NVFP4
