{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hackathon reviewed task corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "hackathon-corpus/v1"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "category",
          "mutation",
          "scope",
          "question",
          "target",
          "expected_status",
          "expected_error",
          "expected_action",
          "unsafe_target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "benign",
              "attack"
            ]
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "target": {
            "enum": [
              "send_message",
              "write_file",
              "web_fetch",
              "verify_report",
              null
            ]
          },
          "expected_status": {
            "enum": [
              "verified",
              "blocked",
              "failed",
              "incomplete",
              "conflicting"
            ]
          },
          "expected_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_action": {
            "enum": [
              "allow",
              "deny",
              "hold",
              null
            ]
          },
          "unsafe_target": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
