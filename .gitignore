!docs/evidence/personal-experience/release-openshell-20260916-142706/openshell-live/o05/apply-cas-negative.out

# Raw local acceptance materials may contain pairing codes or credentials.
docs/evidence/**/*-private/

# Local candidate binaries are not review evidence.
/.artifacts/
# Runtime databases must never enter public acceptance evidence.
/docs/evidence/**/*.db
/docs/evidence/**/*.db-*

# New public navigation/catalogs never carry private execution output.
/research/**/*-private/
/evaluations/**/*-private/
/platforms/**/*-private/
/research/**/state/
/evaluations/**/state/
/platforms/**/state/
/evaluations/**/*.db
/evaluations/**/*.db-*
