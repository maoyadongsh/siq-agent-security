# Go
*.test
*.out

# connectors/<name>/<name> 是 `go build ./...`（不带 -o）在该目录下的默认产物
# ——本地起 Go 工具链跑 vet/test 时容易顺手生成，不应提交（与已跟踪的预置
# 二进制区分：已跟踪的走 git rm 显式移除，这里只挡住新产生的同名可执行文件）
connectors/dify/dify
connectors/kubernetes/kubernetes
connectors/mcp/mcp
connectors/piagent/piagent
connectors/process/process
connectors/systemd/systemd
connectors/workbuddy/workbuddy

# 编辑器与系统
.idea/
.vscode/
.DS_Store

# 本机门禁构建产物（签名清单只随发行包提供，开发源码目录不附清单）
apps/agentshield/agentshield
apps/agentshield/agentshield.exe
apps/agentshield/siq-agent-security
apps/agentshield/siq-agent-security.exe
apps/agentshield/.state/

# 发布私钥（只允许环境变量 SIQ_AGENT_SECURITY_RELEASE_SEED，兼容 AGENTSHIELD_RELEASE_SEED）
*.release.seed
secrets/

# Isolated competition runtime, fixtures, model output and credentials
.tmp/

# Local SonarScanner output (not source or review evidence).
.scannerwork/

!docs/evidence/personal-experience/release-openshell-20260916-142706/openshell-live/o05/apply-deny.out
!docs/evidence/personal-experience/release-openshell-20260916-142706/openshell-live/o05/doctor-unreachable.out
!docs/evidence/personal-experience/release-openshell-20260916-142706/openshell-live/o05/apply-ok.out
